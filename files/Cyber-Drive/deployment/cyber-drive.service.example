[Unit]
Description=Cyber Drive Flask application
After=network.target

[Service]
Type=simple
User=cyberdrive
Group=cyberdrive
WorkingDirectory=/opt/cyber-drive
EnvironmentFile=/etc/cyber-drive/cyber-drive.env
ExecStart=/opt/cyber-drive/.venv/bin/waitress-serve --listen=127.0.0.1:6969 main:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cyber-drive /var/log/cyber-drive
UMask=0077

[Install]
WantedBy=multi-user.target
